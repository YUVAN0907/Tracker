# =============================================================================
# VendBees Backend — Environment Configuration Template
# =============================================================================
# Copy this file to backend/.env and fill in all values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp Cloud API — from Meta Developers Portal
# https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/wa-dev-console
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v23.0

# Webhook verify token — an arbitrary secret you set in the Meta webhook config.
# Must match exactly what you enter in the Meta App Dashboard → Webhooks.
WHATSAPP_VERIFY_TOKEN=

# App Secret — found in Meta App Dashboard → Settings → Basic.
# Used to verify X-Hub-Signature-256 on every incoming webhook event.
# REQUIRED for production. Without this, webhook signature verification is skipped.
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# Firebase / Google Cloud
# -----------------------------------------------------------------------------
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Google Application Default Credentials (for Cloud Run, set via IAM instead)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Flask Server
# -----------------------------------------------------------------------------
PORT=3002

# Comma-separated list of allowed frontend origins (for CORS).
# In production, list your exact domain(s). Do NOT use wildcard (*).
# Example: https://dashboard.vendbees.com,https://admin.vendbees.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
